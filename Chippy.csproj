<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImPlot" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.2" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets/**/*;Backends/Brutal/Shaders/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
